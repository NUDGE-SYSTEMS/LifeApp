{
  "name": "lifeapp",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "android": "node scripts/run.mjs android",
    "android:release": "node scripts/run.mjs android --release",
    "ios": "node scripts/run.mjs ios",
    "ios:release": "node scripts/run.mjs ios --release",
    "web": "expo start --web",
    "doctor": "node scripts/doctor.mjs",
    "prebuild": "expo prebuild --platform all",
    "prebuild:clean": "expo prebuild --platform all --clean",
    "build:preview": "eas build --platform all --profile preview",
    "build:production": "eas build --platform all --profile production",
    "update": "eas update --branch production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@kevinpatil/envguard": "^1.0.3",
    "@types/react": "~19.1.10",
    "typescript": "^5.3.3"
  },
  "private": true
}
